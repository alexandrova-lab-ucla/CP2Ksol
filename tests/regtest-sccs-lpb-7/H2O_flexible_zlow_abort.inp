# FLEXIBLE with only one edge of the planar window. MUST ABORT (non-zero exit) with
# 'SCCS REGION needs both LOWER_EDGE and UPPER_EDGE'. Not listed in TEST_FILES.toml; run by hand.
&GLOBAL
  PRINT_LEVEL medium
  PROJECT H2O_flexible_zlow_abort
  RUN_TYPE ENERGY_FORCE
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 0
    &MGRID
      CUTOFF 600
      NGRIDS 4
    &END MGRID
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCCS on
      ALPHA [N*m^-1] 0.0
      BETA [kbar] 0.0
      GAMMA [mN/m] 0.0
      DELTA_RHO 2.0E-5
      DERIVATIVE_METHOD fft
      DIELECTRIC_CONSTANT 78.36
      EPS_SCCS 1.0E-8
      EPS_SCF 0.5
      MAX_ITER 200
      METHOD SOLVENT_EXCLUDED
      MIXING 0.6
      SOLVER NEWTON_CG
      SOLVER_TOLERANCE 1.0E-9
      SOLVER_MAX_ITER 50
      ION_CONCENTRATION 1.0
      NONLINEAR_IONS T
      ION_STERIC_RADIUS [angstrom] 4.0
      TEMPERATURE [K] 298.0
      ION_VALENCE 1.0
      NONLINEAR_DIELECTRIC T
      EPS_INF 1.78
      SOLVENT_DENSITY [angstrom^-3] 0.0335
      SOLVENT_DIPOLE 0.9449
      &REGION
        WIDTH [angstrom] 0.5
        LOWER_EDGE [angstrom] 5.0
        &FLEXIBLE
          KIND O 1.0
          COARSE_GRAINING_LENGTH [angstrom] 1.5
          DENSITY [angstrom^-3] 0.005
          OFFSET [angstrom] 0.5
        &END FLEXIBLE
      &END REGION
      &SOLVENT_EXCLUDED
        RHO_CAVITY [angstrom^-3] 0.015
        SWITCH_WIDTH 0.6
        PROBE_KERNEL_WIDTH [angstrom] 0.125
        SOLVENT_RADIUS [angstrom] 1.4
        ION_RADIUS [angstrom] 4.0
        DIELECTRIC_RADIUS [angstrom] 1.0
        CAVITATION_RADIUS [angstrom] 0.0
      &END SOLVENT_EXCLUDED
    &END SCCS
    &SCF
      EPS_SCF 1.0E-8
      MAX_SCF 200
      SCF_GUESS atomic
      &MIXING on
        ALPHA 0.2
      &END MIXING
      &PRINT
        &RESTART off
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 8.0 8.0 8.0
      PERIODIC XYZ
    &END CELL
    &COORD
      O         4.0000000000        4.0000000000        4.2981545000
      H         4.0000000000        4.7632390000        3.7018455000
      H         4.0000000000        3.2367610000        3.7018455000
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
