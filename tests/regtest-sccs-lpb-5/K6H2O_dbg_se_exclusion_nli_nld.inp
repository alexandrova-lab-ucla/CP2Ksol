# (b) NONLINEAR_DIELECTRIC T and NONLINEAR_IONS T
# K+ + 6 H2O (K-O 2.8 A, octahedral, water C2 axes pointing away from K) in a 15 A cubic box, METHOD
# SOLVENT_EXCLUDED, NONLINEAR_DIELECTRIC T, NONLINEAR_IONS T (size-modified ions, ION_STERIC_RADIUS 4 A), &SCCS&EXCLUSION on for the kinds Ow, Hw and K, RUN_TYPE DEBUG
# EXPECTED: max |f(numerical) - f(analytical)| <= 1E-4 Ha/bohr and <= 0.1 % relative on every atom (all 19 atoms
# are excluded atoms). The exclusion force reaches the output through the pseudo-core force bucket; the numbers are
# the sum of all force terms, so the check also pins that the rank-summed bucket is not double counted: run once on
# 1 and once on 32 MPI ranks (the forces must agree to 1E-8 Ha/bohr).
# Radii are first-pass test values, NOT calibrated: Ow 1.8/2.4, Hw 1.1/1.7, K 2.0/2.6 A.
# Reference values: to be generated on HPC.
&GLOBAL
  PRINT_LEVEL medium
  PROJECT K6H2O_dbg_se_exclusion_nli_nld
  RUN_TYPE DEBUG
&END GLOBAL
&DEBUG
  DEBUG_FORCES T
  DEBUG_STRESS_TENSOR F
  DX 0.001
  EPS_NO_ERROR_CHECK 1.0E-5
  STOP_ON_MISMATCH F
&END DEBUG
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 1
    &MGRID
      CUTOFF 600
      NGRIDS 4
    &END MGRID
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCCS on
      ALPHA [N*m^-1] 0.0
      BETA [kbar] 0.0
      GAMMA [mN/m] 0.0
      DELTA_RHO 2.0E-5
      DERIVATIVE_METHOD fft
      DIELECTRIC_CONSTANT 78.36
      EPS_SCCS 1.0E-8
      EPS_SCF 0.5
      MAX_ITER 200
      METHOD SOLVENT_EXCLUDED
      MIXING 0.6
      SOLVER NEWTON_CG
      SOLVER_TOLERANCE 1.0E-9
      SOLVER_MAX_ITER 50
      DEBYE_LENGTH [angstrom] 3.04
      &EXCLUSION on
        KIND Ow 1.80 2.40
        KIND Hw 1.10 1.70
        KIND K  2.00 2.60
        WIDTH [angstrom] 0.25
        PRINT_SUMMARY T
      &END EXCLUSION
      &SOLVENT_EXCLUDED
        RHO_CAVITY [angstrom^-3] 0.015
        SWITCH_WIDTH 0.6
        PROBE_KERNEL_WIDTH [angstrom] 0.125
        SOLVENT_RADIUS [angstrom] 1.4
        ION_RADIUS [angstrom] 4.0
        DIELECTRIC_RADIUS [angstrom] 1.0
        CAVITATION_RADIUS [angstrom] 0.0
      &END SOLVENT_EXCLUDED
      ION_CONCENTRATION 1.0
      NONLINEAR_IONS T
      ION_STERIC_RADIUS [angstrom] 4.0
      TEMPERATURE [K] 298.0
      ION_VALENCE 1.0
      NONLINEAR_DIELECTRIC T
      EPS_INF 1.78
      SOLVENT_DENSITY [angstrom^-3] 0.0335
      SOLVENT_DIPOLE 0.9449
    &END SCCS
    &SCF
      EPS_SCF 1.0E-8
      MAX_SCF 200
      SCF_GUESS atomic
      &MIXING on
        ALPHA 0.2
      &END MIXING
      &PRINT
        &RESTART off
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC XYZ
    &END CELL
    &COORD
      @INCLUDE K_6H2O.coord
    &END COORD
    &KIND K
      ELEMENT K
      BASIS_SET DZVP-MOLOPT-SR-GTH-q9
      POTENTIAL GTH-PBE-q9
    &END KIND
    &KIND Ow
      ELEMENT O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND Hw
      ELEMENT H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
