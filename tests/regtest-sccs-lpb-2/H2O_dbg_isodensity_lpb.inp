# Tier 2 (c): finite-difference force check (RUN_TYPE DEBUG) of the linear Poisson-Boltzmann term.
# The ionic contribution enters the forces through the Hartree potential with no new force
# topology; if that is wrong, the error appears only once kappa^2 != 0.
# EXPECTED: max |f(numerical) - f(analytical)| <= 1E-4 Ha/bohr.
# CUTOFF 600 Ry is required: at 240 Ry the FFT derivative of ln(eps) is under-resolved and the
# finite-difference noise exceeds the signal. Do not lower it to make the test faster.
# 8 angstrom box to keep the 19 energy evaluations affordable; an equivalent deck takes
# about 160 s on 8 MPI ranks, above the usual regression-dashboard budget.
# EPS_SCF 1E-8 / EPS_SCCS 1E-8 / SOLVER_TOLERANCE 1E-9 keep the finite-difference noise below 1E-4 Ha/bohr.
&GLOBAL
  PRINT_LEVEL medium
  PROJECT H2O_dbg_isodensity_lpb
  RUN_TYPE DEBUG
&END GLOBAL
&DEBUG
  DEBUG_FORCES T
  DEBUG_STRESS_TENSOR F
  DX 0.001
  EPS_NO_ERROR_CHECK 1.0E-5
  STOP_ON_MISMATCH F
&END DEBUG
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 0
    &MGRID
      CUTOFF 600
      NGRIDS 4
    &END MGRID
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCCS on
      ALPHA [N*m^-1] 0.0
      BETA [kbar] 0.0
      GAMMA [mN/m] 0.0
      DELTA_RHO 2.0E-5
      DERIVATIVE_METHOD fft
      DIELECTRIC_CONSTANT 78.36
      EPS_SCCS 1.0E-8
      EPS_SCF 0.5
      MAX_ITER 200
      METHOD ISODENSITY
      MIXING 0.6
      SOLVER NEWTON_CG
      SOLVER_TOLERANCE 1.0E-9
      SOLVER_MAX_ITER 50
      DEBYE_LENGTH [angstrom] 3.04
      &ISODENSITY
        RHO_CAVITY [angstrom^-3] 0.0025
        SWITCH_WIDTH 0.6
      &END ISODENSITY
    &END SCCS
    &SCF
      EPS_SCF 1.0E-8
      MAX_SCF 200
      SCF_GUESS atomic
      &MIXING on
        ALPHA 0.2
      &END MIXING
      &PRINT
        &RESTART off
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 8.0 8.0 8.0
      PERIODIC XYZ
    &END CELL
    &COORD
      O         4.0000000000        4.0000000000        4.2981545000
      H         4.0000000000        4.7632390000        3.7018455000
      H         4.0000000000        3.2367610000        3.7018455000
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
