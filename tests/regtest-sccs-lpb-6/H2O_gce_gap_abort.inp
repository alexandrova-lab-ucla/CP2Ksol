# regtest-sccs-lpb-6 -- ENFORCE_TARGET, target inside a gap: H2O in a 10 A box with the SCCS electrolyte. The target work
# function 5.5 eV (U = 1.06 V vs SHE with PHI_SHE 4.44) lies inside the HOMO-LUMO gap; N_e can move the Fermi level only
# across the gap (a change of N_e by less than 1E-30 e moves it inside), so the secant cannot reach the target. With
# ENFORCE_TARGET T the run must stop with "the target is not reached" and the message "it crosses the target without
# hitting it" (W_f - target had both signs during the updates). Run by hand (expected to abort).
&GLOBAL
  PRINT_LEVEL medium
  PROJECT H2O_gce_gap_abort
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 0
    &MGRID
      CUTOFF 400
      NGRIDS 4
    &END MGRID
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &PRINT
      &SCCS on
        &EACH
          QS_SCF 0
        &END EACH
      &END SCCS
    &END PRINT
    &SCCS on
      ALPHA [N*m^-1] 0.0
      BETA [kbar] 0.0
      GAMMA [mN/m] 0.0
      DELTA_RHO 2.0E-5
      DERIVATIVE_METHOD fft
      DIELECTRIC_CONSTANT 78.36
      EPS_SCCS 1.0E-6
      EPS_SCF 0.5
      MAX_ITER 200
      METHOD ISODENSITY
      MIXING 0.6
      SOLVER NEWTON_CG
      SOLVER_TOLERANCE 1.0E-9
      SOLVER_MAX_ITER 50
      DEBYE_LENGTH [angstrom] 3.04
      &ISODENSITY
        RHO_CAVITY [angstrom^-3] 0.0025
        SWITCH_WIDTH 0.6
      &END ISODENSITY
    &END SCCS
    &SCF
      EPS_SCF 1.0E-6
      MAX_SCF 300
      SCF_GUESS atomic
      ADDED_MOS 10
      &DIAGONALIZATION on
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &SMEAR on
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        NBROYDEN 8
      &END MIXING
      &GCE on
        UPDATE_SCHEME CAPACITANCE
        UPDATE_EVERY SCF_CYCLE
        TARGET_POTENTIAL [eV] 1.06
        PHI_SHE [eV] 4.44
        FERMI_TOL [eV] 0.01
        MAX_OUTER_UPDATES 8
        ENFORCE_TARGET T
      &END GCE
      &PRINT
        &RESTART off
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 10.0 10.0 10.0
      PERIODIC XYZ
    &END CELL
    &COORD
      O         5.0000000000        5.0000000000        5.2981545000
      H         5.0000000000        5.7632390000        4.7018455000
      H         5.0000000000        4.2367610000        4.7018455000
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
