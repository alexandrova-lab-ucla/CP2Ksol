# Legacy-name deck: every renamed keyword is written with its former name; the reference is that of H2O_solvent_excluded_nli_nld_region_probe.inp (names are aliases).
# Post-mask region readings, atom probes, polarisation diagnostics, failure limit.
# Same model as H2O_solvent_excluded_nli_nld_region_apply.inp (Z_LOW 5 A, Z_HIGH 10 A, APPLY T); the new keywords only
# print: PROBE_ATOMS 1 2 (O and one H, sphere radius 3 A), PRINT_POL_DIAGNOSTICS T, MAX_NLPB_FAILURES 5 (never reached
# when the solver converges). The energy must therefore equal the region_apply reference to 1E-10.
# Expected new output lines (grep): 'SCCS| region post-mask' (window, probe atom 1, probe atom 2, cell),
# 'SCCS| pol-diag:'. The 'pre-mask fraction' lines replace the former 'fraction' label.
&GLOBAL
  PRINT_LEVEL medium
  PROJECT H2O_solvent_excluded_nli_nld_region_probe_legacy_names
  RUN_TYPE energy
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 0
    &MGRID
      CUTOFF 400
      NGRIDS 4
    &END MGRID
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &PRINT
      &SCCS on
        &EACH
          QS_SCF 0
        &END EACH
      &END SCCS
    &END PRINT
    &SCCS on
      ALPHA [N*m^-1] 0.0
      BETA [kbar] 0.0
      GAMMA [mN/m] 0.0
      DELTA_RHO 2.0E-5
      DERIVATIVE_METHOD fft
      DIELECTRIC_CONSTANT 78.36
      EPS_SCCS 1.0E-6
      EPS_SCF 0.5
      MAX_ITER 200
      &REGION
        AXIS 3
        Z_LOW [angstrom] 5.0
        Z_HIGH [angstrom] 10.0
        WIDTH [angstrom] 0.5
        APPLY T
        PROBE_ATOMS 1 2
        PROBE_RADIUS [angstrom] 3.0
      &END REGION
      METHOD SOLVENT_EXCLUDED
      MIXING 0.6
      SOLVER NEWTON_CG
      NLPB_ENERGY_TOL 1.0E-10
      DEBUG_NLPB F
      EPS_NLPB 1.0E-8
      MAX_ITER_NLPB 50
      MAX_NLPB_FAILURES 5
      PRINT_POL_DIAGNOSTICS T
      ION_CONCENTRATION 1.0
      NONLINEAR_IONS T
      ION_STERIC_RADIUS [angstrom] 4.0
      TEMPERATURE [K] 298.0
      ION_CHARGE 1.0
      NONLINEAR_DIELECTRIC T
      EPS_INF 1.78
      SOLVENT_DENSITY [angstrom^-3] 0.0335
      SOLVENT_DIPOLE 0.9449
      &SOLVENT_EXCLUDED
        RHO_CAVITY [angstrom^-3] 0.015
        SWITCH_WIDTH 0.6
        PROBE_KERNEL_WIDTH [angstrom] 0.125
        RADIUS_SOLVENT [angstrom] 1.4
        RADIUS_ION [angstrom] 4.0
        RADIUS_DIELECTRIC [angstrom] 1.0
        RADIUS_CAVITATION [angstrom] 0.0
      &END SOLVENT_EXCLUDED
    &END SCCS
    &SCF
      EPS_SCF 1.0E-5
      MAX_SCF 300
      SCF_GUESS atomic
      &MIXING on
        ALPHA 0.2
      &END MIXING
      &PRINT
        &RESTART off
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 10.0 10.0 10.0
      PERIODIC XYZ
    &END CELL
    &COORD
      O         5.0000000000        5.0000000000        5.2981545000
      H         5.0000000000        5.7632390000        4.7018455000
      H         5.0000000000        4.2367610000        4.7018455000
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
