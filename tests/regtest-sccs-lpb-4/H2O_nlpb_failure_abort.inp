# MUST ABORT. One Newton step per solve cannot reach SOLVER_TOLERANCE 1.0E-12, so every SCF step reports
# 'did not converge'; SOLVER_MAX_FAILURES 2 stops the run at the second consecutive failure.
# Expected: non-zero exit, output contains 'SCCS NLPB did not converge in 2 consecutive SCF steps (SOLVER_MAX_FAILURES)'
# and the line 'NLPB| not converged: consecutive failed SCF steps' before it. Run:
#   cp2k.psmp -i H2O_nlpb_failure_abort.inp -o H2O_nlpb_failure_abort.out; echo $?   # must be non-zero
#   grep -c 'SOLVER_MAX_FAILURES' H2O_nlpb_failure_abort.out                          # must be > 0
# With SOLVER_MAX_FAILURES 0 (default) the same deck runs to MAX_SCF with warnings only.
&GLOBAL
  PRINT_LEVEL medium
  PROJECT H2O_nlpb_failure_abort
  RUN_TYPE energy
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 0
    &MGRID
      CUTOFF 400
      NGRIDS 4
    &END MGRID
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &PRINT
      &SCCS on
        &EACH
          QS_SCF 0
        &END EACH
      &END SCCS
    &END PRINT
    &SCCS on
      ALPHA [N*m^-1] 0.0
      BETA [kbar] 0.0
      GAMMA [mN/m] 0.0
      DELTA_RHO 2.0E-5
      DERIVATIVE_METHOD fft
      DIELECTRIC_CONSTANT 78.36
      EPS_SCCS 1.0E-6
      EPS_SCF 0.5
      MAX_ITER 200
      &REGION
        AXIS 3
        LOWER_EDGE [angstrom] 5.0
        UPPER_EDGE [angstrom] 10.0
        WIDTH [angstrom] 0.5
        APPLY T
      &END REGION
      METHOD SOLVENT_EXCLUDED
      MIXING 0.6
      SOLVER NEWTON_CG
      SOLVER_TOLERANCE 1.0E-12
      SOLVER_MAX_ITER 1
      SOLVER_MAX_FAILURES 2
      ION_CONCENTRATION 1.0
      NONLINEAR_IONS T
      ION_STERIC_RADIUS [angstrom] 4.0
      TEMPERATURE [K] 298.0
      ION_VALENCE 1.0
      NONLINEAR_DIELECTRIC T
      EPS_INF 1.78
      SOLVENT_DENSITY [angstrom^-3] 0.0335
      SOLVENT_DIPOLE 0.9449
      &SOLVENT_EXCLUDED
        RHO_CAVITY [angstrom^-3] 0.015
        SWITCH_WIDTH 0.6
        PROBE_KERNEL_WIDTH [angstrom] 0.125
        SOLVENT_RADIUS [angstrom] 1.4
        ION_RADIUS [angstrom] 4.0
        DIELECTRIC_RADIUS [angstrom] 1.0
        CAVITATION_RADIUS [angstrom] 0.0
      &END SOLVENT_EXCLUDED
    &END SCCS
    &SCF
      EPS_SCF 1.0E-5
      MAX_SCF 300
      SCF_GUESS atomic
      &MIXING on
        ALPHA 0.2
      &END MIXING
      &PRINT
        &RESTART off
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 10.0 10.0 10.0
      PERIODIC XYZ
    &END CELL
    &COORD
      O         5.0000000000        5.0000000000        5.2981545000
      H         5.0000000000        5.7632390000        4.7018455000
      H         5.0000000000        4.2367610000        4.7018455000
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
