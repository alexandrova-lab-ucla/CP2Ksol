# SE model with explicit water (&EXCLUSION, &REGION/&FLEXIBLE), constant potential: Cu(111) 4x4x4 slab (203 atoms: 64 Cu, 46 H2O, 1 K+), Gamma point, MD at 300 K, 1 fs steps.
# Held at -0.600 V vs SHE; the electron number is updated every 5 steps (UPDATE_INTERVAL 5). Run: cp2k.psmp -i film203_se.inp -o film203_se.out
&GLOBAL
  PRINT_LEVEL low
  PROJECT film203_se
  RUN_TYPE MD
  SEED 4242
  WALLTIME 28000
&END GLOBAL
&MOTION
  &MD
    ENSEMBLE NVT
    STEPS 2000
    TIMESTEP [fs] 1.0
    TEMPERATURE [K] 300.0
    &THERMOSTAT
      TYPE CSVR
      &CSVR
        TIMECON [fs] 100
      &END CSVR
    &END THERMOSTAT
  &END MD
  &CONSTRAINT
    &FIXED_ATOMS
      COMPONENTS_TO_FIX XYZ
      LIST 1..32
    &END FIXED_ATOMS
  &END CONSTRAINT
  &PRINT
    &TRAJECTORY
      &EACH
        MD 1
      &END EACH
    &END TRAJECTORY
    &RESTART
      BACKUP_COPIES 1
      &EACH
        MD 1
      &END EACH
    &END RESTART
  &END PRINT
&END MOTION
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 0
    &MGRID
      CUTOFF 400
      REL_CUTOFF 40
      NGRIDS 4
      &RS_GRID
        MAX_DISTRIBUTED_LEVEL 1
      &END RS_GRID
    &END MGRID
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-10
      EXTRAPOLATION ASPC
      EXTRAPOLATION_ORDER 3
    &END QS
    &PRINT
      &SCCS on
        &EACH
          QS_SCF 0
        &END EACH
      &END SCCS
    &END PRINT
    &SCCS on
      RELATIVE_PERMITTIVITY 78.4
      GAMMA [mN/m] 0.0
      DELTA_RHO 2.0E-5
      DERIVATIVE_METHOD fft
      EPS_SCCS 1.0E-6
      EPS_SCF 0.5
      MAX_ITER 200
      SOLVER NEWTON_CG
      SOLVER_TOLERANCE 1.0E-8
      SOLVER_MAX_ITER 50
      DEBYE_LENGTH [angstrom] 3.0
      NONLINEAR_IONS F
      NONLINEAR_DIELECTRIC F
      SOLVER_GRID_LEVEL 1
      METHOD SOLVENT_EXCLUDED
      &SOLVENT_EXCLUDED
        RHO_CAVITY [angstrom^-3] 0.0158
        SWITCH_WIDTH 0.6
        PROBE_KERNEL_WIDTH [angstrom] 0.125
        SOLVENT_RADIUS [angstrom] 1.4
        ION_RADIUS [angstrom] 4.0
        DIELECTRIC_RADIUS [angstrom] 0.7
        CAVITATION_RADIUS [angstrom] 0.0
      &END SOLVENT_EXCLUDED
      &REGION
        AXIS 3
        WIDTH [angstrom] 0.5
        PROBE_ATOMS 65
        PROBE_RADIUS [angstrom] 3.0
        &FLEXIBLE
          KIND Ow 1.0
          KIND K 1.0
        &END FLEXIBLE
      &END REGION
      &EXCLUSION on
        KIND Ow 1.80 2.40
        KIND Hw 1.10 1.70
        KIND K  2.00 2.60
        WIDTH [angstrom] 0.25
        PRINT_SUMMARY T
      &END EXCLUSION
      SCF_TOL_FACTOR 0.1
      SOLVER_STRIDE 1
      PSI_FORM T
    &END SCCS
    &SCF
      &GCE on
        UPDATE_SCHEME CAPACITANCE
        UPDATE_EVERY SCF_CYCLE
        UPDATE_INTERVAL 5
        TARGET_POTENTIAL [eV] -0.600
        PHI_SHE [eV] 4.600
        CAPACITANCE_INIT 0.4749
        FERMI_TOL [eV] 0.01
        FERMI_UPDATE_TOL [eV] 0.005
        MIN_STEPS_AFTER_UPDATE 12
        MAX_OUTER_UPDATES 6
        EXCESS_ELECTRONS 0.673537
      &END GCE
      EPS_SCF 1.0E-6
      MAX_SCF 200
      SCF_GUESS ATOMIC
      ADDED_MOS 117
      &SMEAR on
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING on
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        BETA 1.5
        NBROYDEN 8
      &END MIXING
      &PRINT
        &RESTART ON
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3(BJ)
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
  &SUBSYS
    &CELL
      @INCLUDE cell.inc
      PERIODIC XYZ
    &END CELL
    &COORD
      @INCLUDE film203.coord
    &END COORD
    &KIND Cu
      BASIS_SET DZVP-MOLOPT-SR-GTH-q11
      POTENTIAL GTH-PBE-q11
    &END KIND
    &KIND K
      BASIS_SET DZVP-MOLOPT-SR-GTH-q9
      POTENTIAL GTH-PBE-q9
    &END KIND
    &KIND Ow
      ELEMENT O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND Hw
      ELEMENT H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
