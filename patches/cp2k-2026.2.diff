+                  s = 0.5_dp*ERFC(x*fs)
+                  eps_elec%array(i, j, k) = 1.0_dp + e*s
+                  deps_elec%array(i, j, k) = fd*EXP(-0.5_dp*(x/sigma)**2)/rho
+               END IF
+            END DO
+         END DO
+      END DO
+!$OMP END PARALLEL DO
+
+      CALL timestop(handle)
+
+   END SUBROUTINE isodensity_switch
