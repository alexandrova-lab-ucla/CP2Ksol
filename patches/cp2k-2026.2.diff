+! **************************************************************************************************
+!> \brief Occupations at a fractional electron number that is steered toward a target work
+!>        function with a (secant) capacitance: N <- N + C (WF - WF_target), WF = ref_esp - mu.
+!>        The work function is measured at the current N before any update (that value is what the
+!>        convergence check and the GCE printout use); when UPDATE_EVERY SCF_STEP the number is then
+!>        updated and the occupations recomputed at the new N with the same eigenvalues.
+! **************************************************************************************************
+   SUBROUTINE gce_capacitance_occupation(f, mu, kTS, e, nelec0, sigma, maxocc, gce, nelec_out)
+      REAL(KIND=dp), DIMENSION(:), INTENT(OUT)           :: f
+      REAL(KIND=dp), INTENT(OUT)                         :: mu, kTS
+      REAL(KIND=dp), DIMENSION(:), INTENT(IN)            :: e
+      REAL(KIND=dp), INTENT(IN)                          :: nelec0, sigma, maxocc
+      TYPE(gce_type), POINTER                            :: gce
+      REAL(KIND=dp), INTENT(OUT)                         :: nelec_out
+
+      REAL(KIND=dp)                                      :: wf
+
+      CALL gce_init_electron_number(gce, nelec0)
+      ! measure the Fermi level at the current electron number
+      CALL SmearFixed(f, mu, kTS, e, gce%n_target, sigma, maxocc, smear_fermi_dirac)
+      wf = gce%ref_esp - mu
+      IF (gce%prev_workfunction < -500.0_dp) THEN
+         ! first measurement (atomic guess): no update, and no secant history yet
+         CONTINUE
+      ELSE IF (gce%update_every_step .AND. gce%scf_delta < gce%update_delta .AND. &
+               ABS(wf - gce%target_workfunction) > gce%fermi_tol) THEN
+         ! update only on a nearly converged density and only while the work function is off target by
+         ! more than FERMI_TOL: once inside the tolerance the electron number is frozen so the SCF can
+         ! finish (repeated tiny updates would keep kicking the density)
+         CALL gce_update_nelectron(gce, wf)
+         CALL SmearFixed(f, mu, kTS, e, gce%n_target, sigma, maxocc, smear_fermi_dirac)
+      END IF
+      gce%prev_workfunction = wf
+      nelec_out = gce%n_target
+   END SUBROUTINE gce_capacitance_occupation
+
+! **************************************************************************************************
+!> \brief First occupation call: N_e starts at the neutral count plus EXCESS_ELECTRONS, or, in a restarted run,
+!>        at the N_e read from the restart state, which must belong to the same input electron count.
+!> \param gce ...
+!> \param nelec0 electron count of the input charge state
+! **************************************************************************************************
+   SUBROUTINE gce_init_electron_number(gce, nelec0)
+      TYPE(gce_type), POINTER                            :: gce
+      REAL(KIND=dp), INTENT(IN)                          :: nelec0
+
+      IF (gce%state_pending) THEN
+         IF (ABS(gce%n_input - nelec0) > 1.0E-6_dp) &
+            CPABORT("GCE: RESTART_N_INPUT is for another system (CHARGE or atoms changed)")
+         ! N_e cannot move in this run (no outer update, no early update, no carry, no dynamics): the restored N_e would
+         ! replace EXCESS_ELECTRONS without a word
+         IF (gce%scheme == 2 .AND. (.NOT. gce%dyn%active) .AND. (.NOT. gce%update_every_step) .AND. gce%max_outer == 0 .AND. &
+             gce%early_update_delta <= 0.0_dp .AND. gce%carry_gain <= 0.0_dp) THEN
+            IF (ABS(gce%n_target - (nelec0 + gce%n_excess_init)) > 1.0E-6_dp) &
+               CALL cp_abort(__LOCATION__, &
+                             "GCE: MAX_OUTER_UPDATES 0 keeps the restored N_e, which differs from the "// &
+                             "EXCESS_ELECTRONS of this input. RESTART_GCE F (or no RESTART_* keywords) "// &
+                             "starts from the new EXCESS_ELECTRONS")
+         END IF
+         gce%state_pending = .FALSE.
+      ELSE IF (gce%n_target < 0.0_dp) THEN
+         gce%n_target = nelec0 + gce%n_excess_init   ! fractional start
+         gce%n_input = nelec0
+      END IF
+   END SUBROUTINE gce_init_electron_number
+
+! **************************************************************************************************
+!> \brief Records, before an update of the converged-SCF loop, the work function (relative to the target) and the
+!>        electron number it belongs to; the extremes of one ionic step explain an unreachable target (ENFORCE_TARGET).
+!>        gce%n_outer already counts the update about to be made.
+!> \param gce ...
+! **************************************************************************************************
+   SUBROUTINE gce_track_update(gce)
+      TYPE(gce_type), POINTER                            :: gce
+
+      REAL(KIND=dp)                                      :: dwf
+
+      dwf = gce%prev_workfunction - gce%target_workfunction
+      IF (gce%n_outer <= 1) THEN
+         gce%wf_lo = dwf
+         gce%wf_hi = dwf
+         gce%n_at_lo = gce%n_target
+         gce%n_at_hi = gce%n_target
+      END IF
+      IF (dwf < gce%wf_lo) THEN
+         gce%wf_lo = dwf
+         gce%n_at_lo = gce%n_target
+      END IF
+      IF (dwf > gce%wf_hi) THEN
+         gce%wf_hi = dwf
+         gce%n_at_hi = gce%n_target
+      END IF
+   END SUBROUTINE gce_track_update
+
+! **************************************************************************************************
+!> \brief One electron-number update. Secant capacitance C = -(N - N_last)/(WF - WF_last)
+!>        (adding electrons lowers the work function) refreshed only when |WF - WF_last| >
+!>        FERMI_UPDATE_TOL, clamped to [CAPACITANCE_MIN, CAPACITANCE_MAX]; step clamped to NE_STEP_MAX.
+!> \param wf work function measured at the current electron number
+! **************************************************************************************************
+   SUBROUTINE gce_update_nelectron(gce, wf)
+      TYPE(gce_type), POINTER                            :: gce
+      REAL(KIND=dp), INTENT(IN)                          :: wf
+
+      REAL(KIND=dp)                                      :: c, dn, dwf
+      LOGICAL                                            :: cross, first, stale
+
+      first = .NOT. gce%secant_ready
+      ! UPDATE_INTERVAL > 1: the pair (n_last, wf_last) of an earlier ionic step carries the geometry drift of the
+      ! steps in between. An update evaluation that can make several updates therefore starts from the last accepted
+      ! capacitance and rebuilds the secant inside the evaluation; one that makes a single update (MAX_OUTER_UPDATES 1,
+      ! CONVERGENCE_MODE 2, mode 1 after the first step) has nothing to rebuild from and uses the pair of the earlier
+      ! step with the new capacitance bounded to 0.5 .. 2 times the last accepted one (not applied for UPDATE_INTERVAL 1)
+      cross = gce%update_interval > 1 .AND. gce%secant_ready .AND. gce%secant_step /= gce%ion_step .AND. &
+              .NOT. gce%freeze_cap
+      stale = cross .AND. gce%max_outer_now > 1
+      gce%n_prev_update = gce%n_target
+      IF (first .AND. gce%freeze_cap) THEN
+         ! EARLY_UPDATE_SECANT: the first early update records its (N_e, WF) pair (WF read on a density that is stable to
+         ! EARLY_UPDATE_WF_STABLE) so the next update has a secant capacitance instead of CAPACITANCE_INIT; without
+         ! the keyword an early update leaves the secant history to the first converged update
+         IF (gce%early_secant) THEN
+            gce%n_last = gce%n_target
+            gce%wf_last = wf
+            gce%secant_ready = .TRUE.
+            gce%secant_step = gce%ion_step
+         END IF
+      ELSE IF (first) THEN
+         ! first update: record the (N_e, WF) pair of a converged density; the initial capacitance is used
+         gce%n_last = gce%n_target
+         gce%wf_last = wf
+         gce%secant_ready = .TRUE.
+         gce%secant_step = gce%ion_step
+      ELSE IF (stale) THEN
+         ! first update of this evaluation: last accepted capacitance, new pair; the next update of the evaluation
+         ! refreshes the secant from points of this evaluation only
+         gce%n_last = gce%n_target
+         gce%wf_last = wf
+         gce%secant_step = gce%ion_step
+      ELSE
+         dwf = wf - gce%wf_last
+         dn = gce%n_target - gce%n_last
+         IF (ABS(dwf) > gce%fermi_update_tol .AND. ABS(dwf) > gce%cap_refresh_min .AND. ABS(dn) > 1.0E-8_dp .AND. &
+             .NOT. gce%freeze_cap) THEN
+            c = -dn/dwf
+            IF (c > 0.0_dp) THEN
+               IF (cross) c = MAX(0.5_dp*gce%capacitance, MIN(2.0_dp*gce%capacitance, c))
+               gce%capacitance = MIN(MAX(c, gce%cap_min), gce%cap_max)
+               gce%cap_measured = .TRUE.   ! M_n of the electron-number dynamics uses a measured C
+            END IF
+            gce%n_last = gce%n_target
+            gce%wf_last = wf
+            gce%secant_step = gce%ion_step
+         END IF
+      END IF
+      dn = gce%capacitance*(wf - gce%target_workfunction)
+      ! FIRST_UPDATE_SIZE: fixed first step, sign from the work-function error
+      IF (first .AND. (.NOT. gce%freeze_cap) .AND. gce%first_update_size > 0.0_dp) THEN
+         dn = SIGN(gce%first_update_size, wf - gce%target_workfunction)
+      END IF
+      dn = MAX(-gce%ne_step_max, MIN(gce%ne_step_max, dn))
+      gce%n_target = gce%n_target + dn
+   END SUBROUTINE gce_update_nelectron
+
+! **************************************************************************************************
+!> \brief Is an N_e update allowed before inner convergence? (cycle mode, EARLY_UPDATE_DELTA > 0)
+!>        True when the density change is small, enough steps ran at the current N_e, the work function
+!>        is off target by more than FERMI_TOL, the outer-update budget is left and the ionic step is an
+!>        update step (same gates as the converged-SCF update in qs_scf).
+! **************************************************************************************************
+   FUNCTION gce_early_update_due(gce, iter_delta) RESULT(due)
+      TYPE(gce_type), POINTER                            :: gce
+      REAL(KIND=dp), INTENT(IN)                          :: iter_delta
+      LOGICAL                                            :: due
+      LOGICAL                                            :: stable
+
+      stable = gce%early_wf_stable <= 0.0_dp .OR. ABS(gce%prev_workfunction - gce%wf_prev_step) < gce%early_wf_stable
+      gce%wf_prev_step = gce%prev_workfunction
+      due = gce%prev_workfunction > -500.0_dp .AND. iter_delta < gce%early_update_delta .AND. stable .AND. &
+            gce%n_early < gce%early_update_max .AND. &
+            gce%steps_since_update >= gce%early_update_min_steps .AND. &
+            ABS(gce%prev_workfunction - gce%target_workfunction) > gce%fermi_tol .AND. &
+            (gce%ion_step == 0 .OR. MOD(gce%ion_step + 1, gce%update_interval) == 0)
+   END FUNCTION gce_early_update_due
+
+! **************************************************************************************************
+!> \brief Is the mixer history kept after the update just done? (|dN_e| < KEEP_MIXER_BELOW)
+! **************************************************************************************************
+   FUNCTION gce_keep_mixer(gce) RESULT(keep)
+      TYPE(gce_type), POINTER                            :: gce
+      LOGICAL                                            :: keep
+
+      keep = gce%keep_mixer_below > 0.0_dp .AND. ABS(gce%n_target - gce%n_prev_update) < gce%keep_mixer_below
+   END FUNCTION gce_keep_mixer
+
 END MODULE qs_mo_occupation
