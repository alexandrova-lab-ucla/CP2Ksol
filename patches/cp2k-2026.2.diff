+! **************************************************************************************************
+!> \brief Work-around for a memory leak in the intra-node single-copy transfers (CMA, XPMEM) of Cray MPICH 9.0.x.
+!>        ScaLAPACK PDSYEVD / PZHEEVD of Cray libsci (cp_fm_syevd, cp_cfm_heevd) send strided BLACS messages; every call
+!>        leaves memory behind, so the rank heap grows linearly with the number of diagonalisations. When about 4 GiB
+!>        are lost, MPI_Type_vector fails with "Out of memory"; with MPI_ERRORS_RETURN, as CP2K sets it, all ranks then
+!>        wait in BLACS for ever. MPICH_SMP_SINGLE_COPY_MODE=NONE removes the growth. Batch jobs may start with
+!>        MPICH_SMP_SINGLE_COPY_MODE=CMA, so CMA and XPMEM are replaced too; any other value (NONE) is kept. The setting
+!>        is read by MPI_Init, so it is made here before MPI starts. Only with Cray MPICH (CRAY_MPICH_VERSION set).
+! **************************************************************************************************
+   SUBROUTINE guard_cray_mpich()
+      USE ISO_C_BINDING, ONLY: C_CHAR, C_INT, C_NULL_CHAR
+
+      INTERFACE
+         FUNCTION c_setenv(name, VALUE, overwrite) BIND(C, name="setenv") RESULT(rc)
+            IMPORT :: C_CHAR, C_INT
+            CHARACTER(KIND=C_CHAR), DIMENSION(*), INTENT(IN) :: name, VALUE
+            INTEGER(KIND=C_INT), VALUE                       :: overwrite
+            INTEGER(KIND=C_INT)                              :: rc
+         END FUNCTION c_setenv
+      END INTERFACE
+
+      CHARACTER(LEN=1)  :: dummy
+      CHARACTER(LEN=16) :: mode
+      INTEGER           :: st_cray, st_mode, rc
+      LOGICAL           :: replace
+
+      CALL GET_ENVIRONMENT_VARIABLE("CRAY_MPICH_VERSION", dummy, STATUS=st_cray)
+      mode = ""
+      CALL GET_ENVIRONMENT_VARIABLE("MPICH_SMP_SINGLE_COPY_MODE", mode, STATUS=st_mode)
+      ! STATUS: 0 set, -1 set (value longer than the variable), 1 not set
+      replace = (st_mode == 1)
+      IF (st_mode == 0) replace = (mode == "CMA" .OR. mode == "cma" .OR. mode == "XPMEM" .OR. mode == "xpmem")
+      IF ((st_cray == 0 .OR. st_cray == -1) .AND. replace) THEN
+         rc = c_setenv("MPICH_SMP_SINGLE_COPY_MODE"//C_NULL_CHAR, "NONE"//C_NULL_CHAR, 1_C_INT)
+      END IF
+   END SUBROUTINE guard_cray_mpich
+
 END PROGRAM cp2k
